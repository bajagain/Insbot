# Copy this file to .env and fill in the values.
# ── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# ── Dosco (the one and only Instagram data source) ─────────
# Insbit talks to Dosco and only Dosco. Set the base URL to enable it.
# Until it is set, Insbit reports data as unavailable (no other source).
DOSCO_BASE_URL=

# Optional: Dosco works without a key today. Add one here and it is sent
# automatically using the auth settings below.
DOSCO_API_KEY=
# How the key is sent when present:
DOSCO_AUTH_HEADER=Authorization
DOSCO_AUTH_SCHEME=Bearer
# Set this to send the key as a query parameter instead of a header:
DOSCO_KEY_QUERY_PARAM=

# Endpoint paths + query parameter names (adjust to match Dosco's docs):
DOSCO_PROFILE_PATH=/profile
DOSCO_POSTS_PATH=/posts
DOSCO_FOLLOWING_PATH=/following
DOSCO_USERNAME_PARAM=username
DOSCO_CURSOR_PARAM=cursor
DOSCO_TIMEOUT_MS=10000

# ── Rate limiting ──────────────────────────────────────────
USER_REQUEST_LIMIT=20
USER_REQUEST_WINDOW_SECONDS=60

# Global cap on outbound provider requests (safety valve)
PROVIDER_REQUEST_LIMIT=60
PROVIDER_REQUEST_WINDOW_SECONDS=60

# ── Cache TTLs (seconds) ───────────────────────────────────
PROFILE_CACHE_TTL=900
POST_CACHE_TTL=600
FOLLOWING_CACHE_TTL=600

# ── Retention / cleanup (seconds) ──────────────────────────
PROFILE_RETENTION_SECONDS=86400
SESSION_RETENTION_SECONDS=3600
MAX_BACKUPS=5

# ── Runtime ────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
DATA_DIR=./data
